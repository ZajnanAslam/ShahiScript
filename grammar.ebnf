program ::= "Bismillah" statement_list "AllahHafiz"

statement_list ::= statement { statement }

statement ::= declaration_statement
            | print_statement
            | if_statement

declaration_statement ::= "daulat" IDENTIFIER "=" expression ";"

print_statement ::= "farman" ( STRING | expression ) ";"

if_statement ::= "agar" "(" expression ")" "phir" statement_list [ "varna" statement_list ] "khatam" ";"

expression ::= boolean_expression

boolean_expression ::= arithmetic_expression [ ( ">" | "<" | "==" | "!=" ) arithmetic_expression ]

arithmetic_expression ::= term { ( "+" | "-" ) term }

term ::= factor { ( "*" | "/" ) factor }

factor ::= IDENTIFIER
         | NUMBER
         | "(" expression ")"

IDENTIFIER ::= [a-zA-Z_][a-zA-Z0-9_]*
NUMBER ::= [0-9]+ ( "." [0-9]* )?
STRING ::= '"' [^"]* '"'
